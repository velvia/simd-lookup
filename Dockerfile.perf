# Dockerfile for cache profiling with Linux perf
# Usage: docker build -f Dockerfile.perf -t simd-lookup-perf .
#        docker run --privileged -it simd-lookup-perf

# Use ARM64 platform explicitly for native performance on M1/M2 Macs
# This ensures perf counters work properly (not emulated)
FROM --platform=linux/arm64 rust:1.89-slim

# Install perf and required tools
# Note: On Debian/Ubuntu, perf is in linux-perf package
# On some systems it might be in linux-tools-generic or just 'perf'
RUN apt-get update && \
    apt-get install -y \
    linux-perf \
    file \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/* || \
    (apt-get update && apt-get install -y perf file build-essential pkg-config && rm -rf /var/lib/apt/lists/*)

# Set working directory
WORKDIR /workspace

# Copy Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo

# Copy source code
COPY src ./src
COPY benches ./benches
COPY examples ./examples

# Build the project in release mode
RUN cargo build --release --benches

# Default command - run perf stat with cache events
# Note: The actual command is handled by docker_perf.sh script
CMD ["bash"]

